NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: Shiprocket (server only). Use an API user from Shiprocket → Settings → API, not the panel login.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Pickup address nickname as set in Shiprocket → Settings → Pickup Addresses, and its pincode.
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_PICKUP_PINCODE=411045
# Packed weight (kg) used for the product-page delivery check.
SHIPROCKET_DEFAULT_WEIGHT_KG=20
