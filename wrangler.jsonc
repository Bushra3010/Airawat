{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "airawat",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    // Lets the worker call itself to refresh cached pages.
    { "binding": "WORKER_SELF_REFERENCE", "service": "airawat" }
  ],
  "kv_namespaces": [
    // Cached pages and their revalidation tags. KV stores airawat-page-cache and airawat-tag-cache.
    { "binding": "NEXT_INC_CACHE_KV", "id": "944ad486c49d48019134ce0b6968ee1f" },
    { "binding": "NEXT_TAG_CACHE_KV", "id": "be29fb6a5944409cb64fb0e405919d11" }
  ],
  "vars": {
    "SHIPROCKET_PICKUP_LOCATION": "work",
    "SHIPROCKET_EMAIL": "workblinksai@gmail.com"
  },
  "routes": [
    { "pattern": "airawathandicraft.com", "custom_domain": true },
    { "pattern": "www.airawathandicraft.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
