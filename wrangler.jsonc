{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "airawat",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    // Lets the worker call itself to refresh cached pages.
    { "binding": "WORKER_SELF_REFERENCE", "service": "airawat" }
  ],
  "kv_namespaces": [
    // Cached pages and their revalidation tags. Fill in the ids after `wrangler kv namespace create`.
    { "binding": "NEXT_INC_CACHE_KV", "id": "REPLACE_INC_CACHE_ID" },
    { "binding": "NEXT_TAG_CACHE_KV", "id": "REPLACE_TAG_CACHE_ID" }
  ],
  "vars": {
    "SHIPROCKET_PICKUP_LOCATION": "work"
  },
  "observability": { "enabled": true }
}
