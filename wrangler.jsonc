{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "airawat",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "SHIPROCKET_PICKUP_LOCATION": "work",
    "SHIPROCKET_EMAIL": "workblinksai@gmail.com"
  },
  // Keep the free *.workers.dev address on alongside the custom domain.
  "workers_dev": true,
  "routes": [
    { "pattern": "airawathandicraft.com", "custom_domain": true },
    { "pattern": "www.airawathandicraft.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
